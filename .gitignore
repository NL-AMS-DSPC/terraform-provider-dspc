# .gitignore for Terraform Provider

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
terraform-provider-asc
terraform-provider-asc.exe

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Terraform files
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Test files
test-fixtures/

# Compiled binaries
terraform-provider-asc_linux_amd64
terraform-provider-asc_darwin_amd64
terraform-provider-asc_darwin_arm64
terraform-provider-asc_windows_amd64.exe

# coverage reports
coverage.out
coverage.html
coverage.xml
coverage.txt
coverage/

# AI guidelines
SKILL_BACKEND.md
SKILL_FRONTEND.md
BACKEND.instructions.md
FRONTEND.instructions.md
